{
  "name": "@golproductions/check",
  "version": "4.1.4",
  "description": "Less hallucinations. A command firewall for Claude Code: validates every shell command before execution, so fabricated commands are denied before they run.",
  "bin": {
    "check": "dist/index.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "release": "node release.mjs",
    "prepublishOnly": "node build.mjs && node test/version-lock.mjs && node test/upgrade-path.mjs",
    "verify": "node test/shipped-truth.mjs",
    "test:install": "node test/install-e2e.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "anti-hallucination",
    "ai-hallucination",
    "ai-agents",
    "ai-coding-agent",
    "claude-code",
    "ai-safety",
    "developer-tools"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/golproductions/check.git"
  },
  "homepage": "https://golproductions.com/check"
}
